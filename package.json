{
  "name": "dsh-docker-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Docker service quick-launch panel for the DSH sidebar.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "docker",
    "sidebar"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "license": "MIT"
}
